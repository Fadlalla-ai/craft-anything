#!/bin/sh
# Craft Anything AppImage entry point (packaging/linux/AppRun; installed by package.sh).
#
# On Wayland the compositor resolves a window's dock icon by taking the window's
# app_id (ai.storyteller.craft-anything) and looking up an installed .desktop file.
# An AppImage installs nothing, so every AppImage run would otherwise show the
# generic "Wayland" icon. Best-effort desktop integration: on first run
# (and whenever the AppImage's path changes) install the .desktop entry and the
# hicolor icons into $XDG_DATA_HOME, then launch. Every failure here must leave
# the launch untouched. Opt out with CRAFT_ANYTHING_NO_DESKTOP_INTEGRATION=1.

set -u

APPDIR="$(dirname "$(readlink -f "$0")")"
DESK_ID=ai.storyteller.craft-anything

integrate() {
  case "${CRAFT_ANYTHING_NO_DESKTOP_INTEGRATION:-}" in
    1 | true | yes) return 0 ;;
  esac
  # The AppImage runtime exports $APPIMAGE; without it (an extracted AppDir) there
  # is no path to register and nothing to do.
  appimage="${APPIMAGE:-}"
  [ -n "$appimage" ] && [ -f "$appimage" ] || return 0
  appimage="$(readlink -f "$appimage")" || return 0
  # Exec= is parsed by the desktop: a path holding a quote, backquote, dollar, backslash,
  # percent or a line break would need escaping (or could add lines), so skip integration.
  case "$appimage" in
    *[\"\`\$\\%]* | *'
'*) return 0 ;;
  esac
  home="${HOME:-}"
  [ -n "$home" ] || return 0
  data="${XDG_DATA_HOME:-$home/.local/share}"
  src_desktop="$APPDIR/usr/share/applications/$DESK_ID.desktop"
  [ -f "$src_desktop" ] || return 0

  # Rewrite Exec to this AppImage (the binary is not on the host PATH) and drop
  # TryExec, which would hide the entry; everything else is shipped as packaged.
  apps="$data/applications"
  mkdir -p "$apps" 2>/dev/null || return 0
  tmp="$apps/.$DESK_ID.tmp.$$"
  esc="$(printf '%s' "$appimage" | sed 's/[\\&|]/\\&/g')"
  if sed -e "s|^Exec=.*|Exec=\"$esc\" %F|" -e '/^TryExec=/d' "$src_desktop" 2>/dev/null >"$tmp"; then
    if cmp -s "$tmp" "$apps/$DESK_ID.desktop"; then
      rm -f "$tmp"
    else
      if mv -f "$tmp" "$apps/$DESK_ID.desktop" 2>/dev/null; then
        command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$apps" >/dev/null 2>&1
      else
        rm -f "$tmp"
      fi
    fi
  else
    rm -f "$tmp"
    return 0
  fi

  # Icons: per-file compare so an unchanged install costs a handful of cmp calls.
  src_icons="$APPDIR/usr/share/icons/hicolor"
  [ -d "$src_icons" ] || return 0
  icons="$data/icons/hicolor"
  (cd "$src_icons" && find . -type f) | while IFS= read -r rel; do
    mkdir -p "$icons/$(dirname "$rel")" 2>/dev/null || continue
    if ! cmp -s "$src_icons/$rel" "$icons/$rel"; then
      cp "$src_icons/$rel" "$icons/$rel" 2>/dev/null || true
    fi
  done
  refresh_icon_cache "$src_icons" "$icons"
}

# An icon cache another app made in hicolor is trusted while it isn't older than the theme
# folder, and copying into size folders that already exist leaves that folder's time alone:
# the cache doesn't list our icons and menus show a generic one (#1877). So when a trusted
# cache is older than any of our installed icons (copied on this launch or an earlier one),
# or dated in the future, rebuild it; without the tool, make the folder newer so the cache
# counts as out of date and the folders are read instead. Never start a cache where there
# is none. Best-effort.
refresh_icon_cache() {
  cache="$2/icon-theme.cache"
  [ -f "$cache" ] || return 0
  # GTK compares whole seconds: the cache is out of date only when the folder's second is
  # later than the cache's.
  # -L: a hicolor that is a link (a dotfile manager) is judged by the folder, as GTK does.
  cache_s="$(stat -L -c %Y "$cache" 2>/dev/null)" || return 0
  dir_s="$(stat -L -c %Y "$2" 2>/dev/null)" || return 0
  now_s="$(date +%s)" || return 0
  [ "$dir_s" -gt "$cache_s" ] && return 0
  # A folder we can't write (made by root, say) can't be mended: don't retry every launch.
  [ -w "$2" ] || return 0
  # A cache over a minute ahead of this clock was made by one that was ahead; allow a
  # minute so a home on a server whose clock runs a little fast isn't rebuilt every launch.
  if [ "$cache_s" -le $((now_s + 60)) ]; then
    newer="$( (cd "$1" && find . -type f) | while IFS= read -r rel; do
      if [ "$2/$rel" -nt "$cache" ]; then
        echo "$rel"
        break
      fi
    done)"
    [ -n "$newer" ] || return 0
  fi
  for tool in gtk-update-icon-cache gtk4-update-icon-cache; do
    if command -v "$tool" >/dev/null 2>&1 && "$tool" -f -t -q "$2" >/dev/null 2>&1; then
      # An icon dated in the future (a clock that was ahead) would stay newer than the
      # rebuilt cache and bring this back on every launch: date it as the cache.
      (cd "$1" && find . -type f) | while IFS= read -r rel; do
        if [ "$2/$rel" -nt "$cache" ]; then
          touch -r "$cache" "$2/$rel" 2>/dev/null || true
        fi
      done
      return 0
    fi
  done
  # Without the tool: put the folder a second past the cache, so GTK stops trusting it.
  touch -d "@$((cache_s + 1))" "$2" 2>/dev/null || touch "$2" 2>/dev/null || true
}

# The command-line tool ships beside the app but nothing puts it on PATH, and the launcher renames
# the AppImage on every update (#723). `<AppImage> --cli …` runs it, and so does a symlink to the
# AppImage named `craft-anything-cli` (the runtime passes the name it was started by as $ARGV0).
# It writes nothing to the desktop: a CLI or MCP run isn't a launch of the app.
case "${ARGV0:-}" in
  *craft-anything-cli) exec "$APPDIR/usr/bin/craft-anything-cli" "$@" ;;
esac
if [ "${1:-}" = "--cli" ]; then
  shift
  exec "$APPDIR/usr/bin/craft-anything-cli" "$@"
fi

integrate
exec "$APPDIR/usr/bin/craft-anything" "$@"
